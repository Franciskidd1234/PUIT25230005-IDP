{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ],
  "env": {
    "ULTRALYTICS_API_KEY": "@ultralytics_api_key",
    "ULTRALYTICS_ENDPOINT": "@ultralytics_endpoint"
  }
}